
# ============================================================
# LinkShield - Environment Configuration
# ============================================================

# Required
# Generate a strong random secret before production deployment.
SECRET_KEY=change-this-to-64-random-chars

# Server
SERVER_URL=https://your-domain.com

# Database
# Keep the existing database filename for compatibility.
DATABASE_URL=sqlite:///data/ulrtrack.db

# AI Analyst (optional)
# Leave empty to disable AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Privacy
ANONYMIZE_IP=true
VISIT_RETENTION_DAYS=90

# Security
TRUST_PROXY_HEADERS=false
CSP_STRICT=true
SESSION_COOKIE_SECURE=false
REQUIRE_VISIT_TOKEN=true
VISIT_TOKEN_TTL_SECONDS=3600

# Access Gates
REQUIRE_CONSENT=false
ALLOW_PARTIAL_EMAIL_CAPTURE=false
CONSENT_TTL_DAYS=180

# Features
# Optionally mask the public URL using is.gd.
MASK_WITH_ISGD=false

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_SECRET=
SMART_FOLLOWUP_HOURS=48

# Cloudflare Turnstile (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_REDIRECT=60 per minute
RATE_LIMIT_AUTH=10 per minute

# Background Worker
SKIP_BACKGROUND_WORKER=false

# Malicious IP Detection
MALICIOUS_IP_REFRESH_SECONDS=21600
MALICIOUS_IP_MIN_COUNT=1000
